# Local development environment variables for the NLP Database Query Assistant
# Copy this file to .env and replace placeholder values with your own settings.
# Never commit .env or real credentials.

# Default database profile
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=retail_demo
DB_USER=nlp_reader
DB_PASSWORD=your_database_password

# Additional named database profiles, comma-separated.
# Each profile uses DB_<PROFILE>_<SETTING> variables below.
DB_PROFILES=warehouse

DB_WAREHOUSE_DIALECT=postgresql
DB_WAREHOUSE_HOST=warehouse.example.com
DB_WAREHOUSE_PORT=5432
DB_WAREHOUSE_NAME=analytics
DB_WAREHOUSE_USER=readonly_user
DB_WAREHOUSE_PASSWORD=your_warehouse_password

# Supported dialects include mysql, mariadb, postgresql, sqlite, mssql,
# oracle, duckdb, snowflake, and bigquery.

# LLM configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Application configuration
APP_ENV=development
LOG_LEVEL=INFO
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_SECONDS=15
MAX_SQL_CORRECTION_ATTEMPTS=2
